+            w13_layout="w13",
+            trellis_bits=bits,
+            trellis_tile_config=layer.exl3_trellis_tile_config,
+        )
+        for role, (max_tokens, block_m) in roles.items():
+            _, spec = plan_fn(max_tokens, block_m, weight_plan)
+            sizes[role] = max(sizes[role], _spec_nbytes(spec))
+    pool = {
+        role: torch.empty(size, dtype=torch.uint8, device=device)
+        for role, size in sizes.items()
+    }
+    logger.info(
+        "EXL3 rank-sliced per-layer experts: %d counts %s share one scratch "
+        "pool: %s",
+        len(counts),
+        counts,
+        ", ".join(f"{role}={size / (1 << 20):.1f}MiB" for role, size in sizes.items()),
+    )
+    return pool
+
