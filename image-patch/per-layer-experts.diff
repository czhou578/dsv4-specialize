+def _layer_routed_experts(config, prefix: str) -> int:
+    """The routed-expert count of one layer (dsv4-specialize, PLAN_LOADER_PATCH.md §4.2).
+
+    A folder pruned to a different K in each layer lists them in
+    ``n_routed_experts_per_layer``, and ``n_routed_experts`` is the largest.
+    A folder without the list, and every layer past its end, use
+    ``n_routed_experts``: the DSpark draft builds its layers (index 43 and up)
+    with this config, after it sets ``n_routed_experts`` to its own count.
+    """
+    per_layer = getattr(config, "n_routed_experts_per_layer", None)
+    layer_index = extract_layer_index(prefix)
+    if not per_layer or layer_index >= len(per_layer):
+        return config.n_routed_experts
+    count = int(per_layer[layer_index])
+    if not 0 < count <= config.n_routed_experts:
+        raise ValueError(
+            f"n_routed_experts_per_layer[{layer_index}]={count} is outside "
+            f"[1, n_routed_experts={config.n_routed_experts}]"
+        )
+    return count
+
