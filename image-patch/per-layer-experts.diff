+def _spec_nbytes(spec: Any) -> int:
+    numel = 1
+    for size in spec.shape:
+        numel *= int(size)
+    return numel * torch.empty((), dtype=spec.dtype).element_size()
+
+
+def _pool_view(buffer: torch.Tensor, spec: Any) -> torch.Tensor:
+    """A view of a scratch pool with the shape and dtype of one plan's scratch."""
+    nbytes = _spec_nbytes(spec)
+    if nbytes > buffer.numel():
+        raise RuntimeError(
+            f"EXL3 scratch of {nbytes} bytes exceeds its pool of {buffer.numel()} "
+            "bytes; the pool was sized from other plans (PLAN_LOADER_PATCH.md §4.3)"
+        )
+    return buffer[:nbytes].view(spec.dtype).view(tuple(spec.shape))
+
+
+def _plan_scratch_pool(
