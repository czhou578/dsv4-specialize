+    def _layer_heal_state(self, x, residual, post_mix, res_mix):
+        """dsv4-specialize heal (plans/PLAN_FEWER_LAYERS.md §9): merge the open block with the mHC post kernel of the
+        path, apply s + s·M (one map for the streams), and hand the next block the healed state as a merged residual
+        (post 0, comb I), so that its own fused post-pre gives that state."""
+        if self._should_run_b12x_mhc(int(x.shape[0])):
+            from sparkinfer.norm.mhc import run_post as b12x_mhc_post
+
+            s = b12x_mhc_post(x, residual, post_mix, res_mix)
+        else:
+            s = mhc_post_tilelang(x, residual, post_mix, res_mix)
+        s = s + (s.reshape(-1, s.shape[-1]) @ self.layer_heal).reshape(s.shape)
+        eye = torch.eye(self.hc_mult, dtype=res_mix.dtype, device=s.device)
+        return torch.zeros_like(x), s, torch.zeros_like(post_mix), eye.expand_as(res_mix).contiguous()
